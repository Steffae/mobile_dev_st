<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="ru.mirea.elkinasa.bottomnavigationapp.HomeFragment"
        android:label="Главная"
        tools:layout="@layout/fragment_home" />
    <fragment
        android:id="@+id/navigation_info"
        android:name="ru.mirea.elkinasa.bottomnavigationapp.InfoFragment"
        android:label="Информация"
        tools:layout="@layout/fragment_info" />
    <fragment
        android:id="@+id/navigation_profile"
        android:name="ru.mirea.elkinasa.bottomnavigationapp.ProfileFragment"
        android:label="Профиль"
        tools:layout="@layout/fragment_profile" />
</navigation>