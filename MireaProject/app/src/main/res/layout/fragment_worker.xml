<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ui.worker.WorkerFragment">

    <TextView
        android:layout_width="366dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Фоновая задача (Worker)"
        android:textAlignment="center"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textViewStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Статус: ожидание запуска"
        android:textSize="16sp"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Условие запуска:"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✓ Подключение к Wi-Fi"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/buttonStartTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Запустить фоновую задачу"/>

</LinearLayout>