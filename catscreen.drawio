        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart BT\n    %% ===== PRESENTATION (снизу) =====\n    subgraph PRES[\&quot;presentation\&quot;]\n        direction LR\n        P1[\&quot;LoginActivity\&quot;]\n        P2[\&quot;BreedsListActivity\&quot;]\n        P3[\&quot;BreedDetailsActivity\&quot;]\n        P4[\&quot;FavoritesActivity\&quot;]\n        P5[\&quot;RecognizeActivity\&quot;]\n    end\n\n    %% ===== DOMAIN (посередине) =====\n    subgraph DOMAIN[\&quot;domain\&quot;]\n        direction LR\n        U1([\&quot;LoginUseCase\&quot;])\n        U2([\&quot;RegisterUseCase\&quot;])\n        U3([\&quot;GetBreedsUseCase\&quot;])\n        U4([\&quot;SearchBreedsUseCase\&quot;])\n        U5([\&quot;GetBreedByIdUseCase\&quot;])\n        U6([\&quot;AddToFavoritesUseCase\&quot;])\n        U7([\&quot;GetFavoritesUseCase\&quot;])\n        U8([\&quot;RecognizeBreedUseCase\&quot;])\n\n        R1[\&quot;CatRepository\&quot;]\n        R2[\&quot;FavoriteRepository\&quot;]\n        R3[\&quot;AuthRepository\&quot;]\n        R4[\&quot;BreedRecognizer\&quot;]\n    end\n\n    %% ===== DATA (сверху) =====\n    subgraph DATA[\&quot;data\&quot;]\n        direction LR\n        D1[\&quot;CatRepositoryImpl\&quot;]\n        D2[\&quot;FavoriteRepositoryImpl\&quot;]\n        D3[\&quot;AuthRepositoryImpl\&quot;]\n        D4[\&quot;BreedRecognizerImpl\&quot;]\n    end\n\n    %% Presentation -&gt; Domain\n    P1 --&gt; U1\n    P1 --&gt; U2\n    P2 --&gt; U3\n    P2 --&gt; U4\n    P3 --&gt; U5\n    P3 --&gt; U6\n    P4 --&gt; U7\n    P5 --&gt; U8\n\n    %% Domain UseCases -&gt; Repository интерфейсы\n    U1 --&gt; R3\n    U2 --&gt; R3\n    U3 --&gt; R1\n    U4 --&gt; R1\n    U5 --&gt; R1\n    U6 --&gt; R2\n    U7 --&gt; R2\n    U8 --&gt; R4\n\n    %% Data -&gt; Domain (implements)\n    D1 --&gt; R1\n    D2 --&gt; R2\n    D3 --&gt; R3\n    D4 --&gt; R4\n\n    %% Стили\n    classDef pres fill:#fadbd8,stroke:#943126,color:#000\n    classDef dom fill:#fdebd0,stroke:#b9770e,color:#000\n    classDef dat fill:#d6eaf8,stroke:#2874a6,color:#000\n\n    class P1,P2,P3,P4,P5 pres\n    class U1,U2,U3,U4,U5,U6,U7,U8,R1,R2,R3,R4 dom\n    class D1,D2,D3,D4 dat&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="iqGeREmXO7AqjIA5dYsN-96">
